local_github_dev_webhook_id=
local_github_prod_webhook_id=
local_github_webhook_secret=test
local_porkbun_api_key=
local_porkbun_api_secret=
local_backend_dev_api_url=http://localhost:8081
local_backend_prod_api_url=http://localhost:8081
local_your_username=username
local_your_password=password
local_jwt_secret=secret
local_registry_directory=
local_media_directory=

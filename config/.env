# This file is responsible for defining app stage configuration used in infra deployments.
# app_location != app_stage. app location is just where the app stage is deployed,
#  e.g. you might want to run something bound for app_stage=main in app_location=local rather
#  than app_location=hosted (Hetzner) for testing purposes.
#
# For ASCII art, see: https://patorjk.com/software/taag/#p=display&f=Ogre&t=main%20stage

# Used by infra's cloud-init to clone this source. Kept in backup .env because you need in prod.
meblog_private_repo_name=
meblog_public_repo_name=


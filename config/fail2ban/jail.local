[ssh]
enabled  = true
port     = ssh
filter   = sshd
#backend = polling
logpath  = /var/log/auth.log

[nginx-abuse-protect]
enabled   = true
port      = http,https
#backend = polling
logpath   = /var/log/nginx/*.log
banaction = iptables-multiport
maxretry  = 1
findtime  = 3600
bantime   = 600

[recidive-nginx]
enabled   = true
filter    = recidive-nginx
#backend = polling
logpath   = /var/log/fail2ban.log
banaction = iptables-multiport
maxretry  = 2
findtime  = 86400
bantime   = 3600

[nginx-ddos-protect]
enabled   = true
port      = http,https
#backend = polling
logpath   = /var/log/nginx/*.log
banaction = iptables-multiport
maxretry  = 1
findtime  = 3600
bantime   = 300

[nginx-auth-login]
enabled   = true
port      = http,https
filter    = nginx-auth-login
logpath   = /var/log/nginx/access.log
banaction = iptables-multiport
maxretry  = 5
findtime  = 900
bantime   = 3600

[honeypot]
enabled   = true
filter    = honeypot
port      = http,https
logpath   = /var/log/nginx/access.log
banaction = iptables-multiport
maxretry  = 1
findtime  = 86400
bantime   = -1

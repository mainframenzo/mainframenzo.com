# This file is responsible for instructing Git what _not_ to store.

# OS filesystem junk.
**.DS_Store

# Generated by Docker/Vagrant at build time.
.docker
.vagrant

# When running locally for development and testing you usually output to log files.
*.log

# Docker builds log to files.
build-utils/logs/docker*.log

# Used to store metric data locally.
data

# Generated by curl-based backend functional tests.
src/tests.functional.curl/generated/*.sh

# Generated by Python at install/run time.
.venv*
__pycache__

# Generated at install time by NPM and ts-npm.
**node_modules
src/**/package.json
src/**/package-lock.json
src/**/node_modules
src/**/npm*.ts

# Something you are working on.
.badcad

# FIXME Using Blender Python module in a plain Python shell currently requires copying the bpy module
#  from the local install path to here because just using the PyPi-vended
#  module does not work.
# Don't commit these because you don't think you can legally vend them,
#  and also you don't want them here anyways!
bpy

# Generated by my build scripts.
dist*
file_metadata_report*

# Generated by the VSCode extension.
meblog-post-header-validator-0.0.1.vsix

# Generated by Rust.
# FIXME These still get uploaded to our source bucket when deploying CICD regardless of the ignore list built from this file.
src/frontend/one-offs/posts/personal_case_study_number_2/**/target/*

# Generated at deploy time by Terraform.
.terraform
*.tfstate
*.tfstate.backup
.terraform.lock.hcl
terraform.tfvars
src/infra.hetzner/**/*.pem

# Do not commit the llamafiles.
src/backend/*.llamafile

src/infra.local/cloud-config-template.server.yaml

# Generated by curl functional tests.
src/tests.functional.curl/generated/test.sh

# Generated by e2e integration tests.
src/tests.integration.e2e/results
src/tests.integration.e2e/results/*

# Generated at deploy time by the AWS CDK (legacy hosting provider deploy mechanism).
**cdk.out
cdk.out
**cdk.context.json

# This was added for my use of .gitignore as a basis of what to "zip ignore" when zipping source dir for CICD:
# FIXME Still needed?
*node_modules*
*cdk.out*
*dist*
!lib/openapi-includer-cli-main/dist
!lib/ts-npm-main/dist
bpy/*

.pixi

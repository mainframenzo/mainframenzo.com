<!--
This file is responsible for defining what your ops dashboard looks like.
This file gets server-side rendered and is returned as html by your API,
 where JavaScript functionality kicks in.
-->
<div id='monitor'>
  <section>
    <div class='row'>
      <div class='column'>
        <h4>Ops Dashboard - <%= metricAggregateWindow %></h4>
      </div>
      <div class='column'>
        <nav class='ops-nav'>
          <section class='container'>
            <div class='dropdown'>
              <span class='menu-text'>Metrics</span>
              <div id='metrics-windows' class='dropdown-content'>
                <!--<li data-window='raw'>Recent</li>-->
                <li data-window='1m'>1m</li>
                <li data-window='5m'>5m</li>
                <li data-window='15m'>15m</li>
                <hr/>
                <li data-window='1h'>1h</li>
                <li data-window='3h'>3h</li>
                <li data-window='6h'>6h</li>
                <li data-window='12h'>12h</li>
                <hr/>
                <li data-window='1d'>1d</li>
                <li data-window='3d'>3d</li>
                <li data-window='1w'>1w</li>
                <li data-window='2w'>2w</li>
                <hr/>
                <li data-window='1mo'>1mo</li>
              </div>
            </div>
          </section>
        </nav>
      </div>
    </div>
    <hr/>
  </section>
  <section>
    <div class='row'>
      <div class='column'>
        <h4>Escalations (<%= escalations.length %>)</h4>
        <p>Escalations are generated by an LLM based on the last hour's worth of data.</p>
      </div>
      <div class='column'>
        <h4>Failures (<%= Object.keys(rawMetricsToHighlight).length %>)</h4>
        <p>Failures are probably "programmer" error...maybe.</p>
        <ul>
        <%
        Object.keys(rawMetricsToHighlight).forEach((rowNumber) => {
        %>
          <%
          const columnsOfRow = rawMetricsToHighlight[rowNumber];

          columnsOfRow.forEach((columnOfRow) => {
            const metricData = rawMetrics[columnOfRow.metricName];
          %>
          <li>
            <%= columnOfRow.metricName %>
          </li>
          <%
          });
          %>
        <%
        });
        %>
        </ul>
      </div>
    </div>
    <hr/>
    <div class='row'>
      <div class='column'>
        <h4>Requests</h4>
        <%
        if (rawMetricsForRequestsByUri.length === 1) { // No data.
        %>
        <p>No data.</p>
        <%
        } else {
        %>
        <active-table
          id='requested-uris'
          isCellTextEditable='false'
          displayAddNewColumn='false'
          displayAddNewRow='false'
          columnDropdown='{"displaySettings": {"isAvailable": false}}'
          rowDropdown='{"displaySettings": {"isAvailable": false}}'
          frameComponentsStyles='{"style": {"hoverColors": {"backgroundColor": "white"}}}'
          headerStyles='{"hoverColors": {"backgroundColor": "white"}}'
          tableStyle='{"borderRadius":"2px", "width": "100%"}'
          pagination='true'
          data='<%- JSON.stringify(rawMetricsForRequestsByUri) %>'
        ></active-table>
        <%
        }
        %>
      </div>
    </div>
    <hr/>
    <div class='row'>
      <div class='column'>
        <pie-chart
          title='Requests by Web Browser'
          labels='<%- JSON.stringify(browserMetrics.labels) %>'
          datasets='<%- JSON.stringify([{ label: "Browsers", data: browserMetrics.data }]) %>'
        ></pie-chart>
      </div>
      <div class='column'>
        <pie-chart
          title='Requests by Operating System'
          labels='<%- JSON.stringify(osMetrics.labels) %>'
          datasets='<%- JSON.stringify([{ label: "Operating Systems", data: osMetrics.data }]) %>'
        ></pie-chart>
      </div>
    </div>
    <hr/>
    <div class='row'>
      <div class='column'>
        <div id='nginx-blocked-allowed-requests'>
          <!-- 3 line (5, 10, 15 minute) w/ table FIXME stacked bar allowed/301/401/etc-->
          <line-chart
            title="[nginx] Allowed/Blocked Requests"
            labels='["Jan","Feb","Mar"]'
            alarms='[{"label":"in alarm &ge;","data":[75,75,75]}]'
            datasets='[{"label":"5","data":[10,20,15],"borderColor":"#4f46e5"},{"label":"10","data":[40,5,15],"borderColor":"#4f46e5"},{"label":"15","data":[20,10,5],"borderColor":"#4f46e5"}]'
          >
          </line-chart>
        </div>
      </div>
      <div class='column'>
        <div id='fail2ban-blocked-requests'>
          <!-- 2 line (5, 10, 15 minute) w/ table -->
          <line-chart
            title="[fail2ban] Blocked Requests"
            labels='["Jan","Feb","Mar"]'
            alarms='[{"label":"in alarm &ge;","data":[75,75,75]}]'
            datasets='[{"label":"5","data":[10,20,15],"borderColor":"#4f46e5"},{"label":"10","data":[40,5,15],"borderColor":"#4f46e5"},{"label":"15","data":[20,10,5],"borderColor":"#4f46e5"}]'
          >
          </line-chart>
        </div>
      </div>
    </div>
  </section>
  <hr/>
  <section>
    <div class='row'>
      <h4>CPU</h4>
      <div class='column'>
        <div id='cpu-average-load-chart'>
          <line-chart
            title='CPU Average Load'
            labels='<%- JSON.stringify(cpuLoadMetrics.labels) %>'
            alarms='[{"label":"in alarm &ge;","data":<%- JSON.stringify(Array(cpuLoadMetrics.labels.length).fill(75)) %>}]'
            datasets='<%- JSON.stringify(cpuLoadMetrics.datasets) %>'
          ></line-chart>
        </div>
      </div>
      <div class='column'>
        <div id='cpu-utilization-chart'>
          <line-chart
            title='CPU Utilization'
            labels='<%- JSON.stringify(cpuUtilizationMetrics.labels) %>'
            datasets='<%- JSON.stringify(cpuUtilizationMetrics.datasets) %>'
          ></line-chart>
        </div>
      </div>
      <div class='column'>
        <div id='cpu-intensive-processes'>
          <pie-chart
            title='CPU Intensive Processes'
            labels='<%- JSON.stringify(cpuIntensiveProcesses.labels) %>'
            datasets='<%- JSON.stringify([{ label: "CPU %", data: cpuIntensiveProcesses.data }]) %>'
          ></pie-chart>
        </div>
      </div>
    </div>
    <hr/>
    <div class='row'>
      <h4>RAM</h4>
      <div class='column'>
        <div id='ram-usage'>
          <line-chart
            title='RAM Usage'
            labels='<%- JSON.stringify(ramUsageMetrics.labels) %>'
            datasets='<%- JSON.stringify(ramUsageMetrics.datasets) %>'
          ></line-chart>
        </div>
      </div>
      <div class='column'>
        <div id='ram-intensive-processes'>

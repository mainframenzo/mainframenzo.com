            labels='<%- JSON.stringify(ramIntensiveProcesses.labels) %>'
            datasets='<%- JSON.stringify([{ label: "Mem %", data: ramIntensiveProcesses.data }]) %>'
          ></pie-chart>
        </div>
      </div>
      <div class='column'>
        <div id='disk-space-usage'>
          <pie-chart
            title='Disk Space Usage'
            labels='<%- JSON.stringify(diskPartitions.labels) %>'
            datasets='<%- JSON.stringify([{ label: "Used %", data: diskPartitions.data }]) %>'
          ></pie-chart>
        </div>
      </div>
    </div>
    <hr/>
    <div class='row'>
      <h4>RXTX</h4>
      <div class='column'>
        <div id='upload-transfer-rate'>
          <line-chart
            title='Upload Transfer Rate'
            labels='<%- JSON.stringify(uploadTransferRate.labels) %>'
            datasets='<%- JSON.stringify(uploadTransferRate.datasets) %>'
          ></line-chart>
        </div>
      </div>
      <div class='column'>
        <div id='download-transfer-rate'>
          <line-chart
            title='Download Transfer Rate'
            labels='<%- JSON.stringify(downloadTransferRate.labels) %>'
            datasets='<%- JSON.stringify(downloadTransferRate.datasets) %>'
          ></line-chart>
        </div>
      </div>
      <div class='column'>
        <div id='bandwidth'>
          <bar-chart
            title='Bandwidth'
            labels='<%- JSON.stringify(bandwidth.labels) %>'
            datasets='<%- JSON.stringify(bandwidth.datasets) %>'
          ></bar-chart>
        </div>
      </div>
    </div>
    <hr/>
  </section>

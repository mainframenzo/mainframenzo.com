<!DOCTYPE html>
<html lang='en'>
<%- include(`${process.cwd()}/src/frontend/templates.partials/head`); -%>
<body>
  <main class='wrapper' id='bookmarks-page'>
    <%- include(`${process.cwd()}/src/frontend/templates.partials/nav`); -%>
    <section class='container'>
      <%
      if (!bookmarks || bookmarks && bookmarks.length === 0) {
      %>
      <h5 class='title'>Bookmarks</h5>
      <div class='container'>
        <div class='row'>
          <div class='column photo'>
            <image loading='lazy' src='/images/nothing_to_see.jpg'>
            <div class='description'><p>No #bookmarks. Nothing to see here.</p></div>
          </div>
        </div>
      </div>
      <%
      } else {
      %>
      <%- include(`${process.cwd()}/src/frontend/templates.partials/bookmarks`); -%>
      <%
      }
      %>
    </section>
    <%- include(`${process.cwd()}/src/frontend/templates.partials/footer`); -%>
  </main>
</body>
</html>

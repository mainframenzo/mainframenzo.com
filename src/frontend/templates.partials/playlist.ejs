  <noscript>
  <%
  var summaryRows = songAnalysesSummary;
  var summaryHeader = songAnalysesSummary.headings;
  var summaryBody = songAnalysesSummary.data;
  %>
  <table class='song-analyses-summary-noscript' style='border-collapse: collapse; border-radius: 2px; width: 100%; font-family: Inter, sans-serif, Avenir, Helvetica, Arial;'>
    <thead>
      <tr>
        <%
        summaryHeader.forEach(function(header) {
        %>
        <th style='text-align: left; padding-left: 10px; padding-top: 6px; padding-bottom: 6px; border-bottom: 1px solid #cdcdcd; position: sticky; top: 0; background-color: #fff;'><%= header %></th>
        <%
        });
        %>
      </tr>
    </thead>
    <tbody>
      <%
      summaryBody.forEach(function(row, rowIndex) {
      %>
      <tr<%= rowIndex % 2 === 1 ? " style='background-color: #eeeeee7a;'" : "" %>>
        <%
        row.forEach(function(cell) {
        %>
        <td style='padding-left: 10px; padding-top: 4px; padding-bottom: 4px;'><%= (cell === null || cell === undefined) ? "" : cell %></td>
        <%
        });
        %>
      </tr>
      <%
      });
      %>
    </tbody>
  </table>
  </noscript>

  <ol class='playlist-songs'>
    <%
    songs.forEach(function(song, index) {
    %>
    <li class='<%= index === 0 ? 'playlist-track-current' : '' %>' data-track-index='<%= index %>'>
      <figure>
        <input type='checkbox' id='toggle-analyses-<%= song.songId %>' class='analyses-shown-state-checkbox' hidden> <!-- Holds analysis visible state. -->

        <p class='song'><label for='toggle-analyses-<%= song.songId %>' class='toggleable-analyses'></label><b><%= song['Track Name'] %></b></p>
        <p><%= song['Album Name'] %> / <emphasis><%= song['Artist Name(s)'] %></emphasis> - <a href='https://www.youtube.com/watch?v=<%= song.songId %>' target='_blank'>YouTube</a></p>

        <div class='analyses-container'> <!-- Hidden by default. -->
          <!--<song-analysis song-id='<%= song.songId %>'></song-analysis>-->

          <image loading='lazy' src='/playlist-analyzer/all-in-one-infer/visuals/<%= song.songId %>.png' ondblclick='this.requestFullscreen()' class='can-fullscreen'> <!-- Pre-load image. -->
          <p>Analyses song text.</p>
        </div>
      </figure>
      <hr/>
    </li>
    <%
    });
    %>
  </ol>
</div>

  <div id='playlist-data' hidden><%= JSON.stringify(songs) %></div>

  <input type='checkbox' id='expand-all-toggle' class='master-toggle'>
  <label for='expand-all-toggle' class='btn-label'>Expand All / Collapse All</label>

  <meblog-table
    data='<%- escapedSongAnalysesSummary %>'
    text-columns='[0,1,6,7,17,18]'
    scroll-y='400px'
  ></meblog-table>

